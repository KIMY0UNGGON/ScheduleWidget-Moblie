<?xml version="1.0" encoding="utf-8"?>
<!-- record/ : folders FileProvider may share (lecture recordings). -->
<paths>
    <external-files-path name="recordings" path="recordings/" />
    <files-path name="recordings_internal" path="recordings/" />
    <!-- notes/ : flattened PDFs handed to the share sheet. -->
    <cache-path name="notes_share" path="notes-share/" />
    <!-- notes/ : camera photo being taken to insert as a notebook page. -->
    <cache-path name="notes_camera" path="notes-camera/" />
    <!-- update/ : downloaded update APK handed to the system package installer. -->
    <cache-path name="app_updates" path="app-updates/" />
</paths>
